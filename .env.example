# Copy values into your shell or hosting provider's secret manager. Do NOT commit live secrets.
# .env is NOT loaded automatically by this dependency-free Node app.
HOST=127.0.0.1
PORT=8787
BEN_BASE_URL=http://127.0.0.1:8787
BEN_DB_PATH=.local/ben.sqlite
OLLAMA_URL=http://127.0.0.1:11434
BEN_MODEL=qwen3:4b-instruct
# Register a GitHub App; the client secret must be server-side ONLY.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated stable numeric GitHub user IDs; no usernames or guessed IDs.
BEN_FOUNDER_GITHUB_IDS=
BEN_STEWARD_GITHUB_IDS=
# Enable ONLY after policies, safety and privacy requirements have been formally adopted/tested.
BEN_SIGNUPS_ENABLED=false
BEN_ADOPTED_CODE_VERSION=
# Optional separate GitHub App installation for server-side issue publishing.
BEN_GITHUB_APP_ID=
BEN_GITHUB_INSTALLATION_ID=
BEN_GITHUB_PRIVATE_KEY_PATH=
BEN_GITHUB_REPOSITORY=
